# ── local development ────────────────────────────────────────
# Nothing here is required to run Flow on your own machine:
#   npm install && npm start   →  http://localhost:3000
PORT=3000

# ── storage ──────────────────────────────────────────────────
# Unset  → data/db.json on disk (local only).
# Set    → Postgres. Required for any deployment: Vercel gives every
#          request a fresh read-only filesystem, so a JSON file cannot
#          survive between them. Vercel Postgres, Neon and Supabase all
#          hand you a string in this form.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ── access ───────────────────────────────────────────────────
# Flow has no user accounts. Without a password, anyone who finds the URL
# can read and edit your to dos, so this is REQUIRED in production — the
# server refuses to start without it.
# APP_PASSWORD=choose-something-long

# Optional. Rotating this signs everyone out. Defaults to APP_PASSWORD.
# SESSION_SECRET=

# Optional. Lets a calendar app subscribe without signing in:
#   https://your-app.vercel.app/calendar.ics?key=<this>
# CALENDAR_KEY=

# ── Google Calendar sync (optional) ──────────────────────────
# Create an OAuth client at https://console.cloud.google.com
# The redirect URI must match your deployment exactly.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
